# Copy this file to ".env" (the setup script does it for you).

# Where the database lives. For SQLite this is a file inside the project.
# To move to PostgreSQL later, see README.md ("Moving to PostgreSQL").
DATABASE_URL="file:./data/dev.db"

# Set to "true" only when the app is served over HTTPS, so the login cookie
# is never sent over plain HTTP. Leave "false" for use on a local computer/LAN.
COOKIE_SECURE="false"
